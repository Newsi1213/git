<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

  <display-name>CampusQuest</display-name>

  <!-- Filter 顺序即执行顺序：编码 -> CORS -> 自动结算 -> 鉴权 -->
  <filter>
    <filter-name>EncodingFilter</filter-name>
    <filter-class>com.campusquest.filter.EncodingFilter</filter-class>
  </filter>
  <filter>
    <filter-name>CorsFilter</filter-name>
    <filter-class>com.campusquest.filter.CorsFilter</filter-class>
  </filter>
  <filter>
    <filter-name>AutoSettleFilter</filter-name>
    <filter-class>com.campusquest.filter.AutoSettleFilter</filter-class>
  </filter>
  <filter>
    <filter-name>AuthFilter</filter-name>
    <filter-class>com.campusquest.filter.AuthFilter</filter-class>
  </filter>

  <filter-mapping>
    <filter-name>EncodingFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>CorsFilter</filter-name>
    <url-pattern>/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AutoSettleFilter</filter-name>
    <url-pattern>/api/*</url-pattern>
  </filter-mapping>
  <filter-mapping>
    <filter-name>AuthFilter</filter-name>
    <url-pattern>/api/*</url-pattern>
  </filter-mapping>

  <servlet>
    <servlet-name>PingServlet</servlet-name>
    <servlet-class>com.campusquest.servlet.PingServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>PingServlet</servlet-name>
    <url-pattern>/api/ping</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AuthServlet</servlet-name>
    <servlet-class>com.campusquest.servlet.AuthServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AuthServlet</servlet-name>
    <url-pattern>/api/auth/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>TaskServlet</servlet-name>
    <servlet-class>com.campusquest.servlet.TaskServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>TaskServlet</servlet-name>
    <url-pattern>/api/tasks/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>PointServlet</servlet-name>
    <servlet-class>com.campusquest.servlet.PointServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>PointServlet</servlet-name>
    <url-pattern>/api/points/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>CreditServlet</servlet-name>
    <servlet-class>com.campusquest.servlet.CreditServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>CreditServlet</servlet-name>
    <url-pattern>/api/credit/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AppealServlet</servlet-name>
    <servlet-class>com.campusquest.servlet.AppealServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AppealServlet</servlet-name>
    <url-pattern>/api/appeals/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>LeaderboardServlet</servlet-name>
    <servlet-class>com.campusquest.servlet.LeaderboardServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>LeaderboardServlet</servlet-name>
    <url-pattern>/api/leaderboard</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>NotificationServlet</servlet-name>
    <servlet-class>com.campusquest.servlet.NotificationServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>NotificationServlet</servlet-name>
    <url-pattern>/api/notifications/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>ChatServlet</servlet-name>
    <servlet-class>com.campusquest.servlet.ChatServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>ChatServlet</servlet-name>
    <url-pattern>/api/conversations/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>StatsServlet</servlet-name>
    <servlet-class>com.campusquest.servlet.StatsServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>StatsServlet</servlet-name>
    <url-pattern>/api/stats/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AdminServlet</servlet-name>
    <servlet-class>com.campusquest.servlet.AdminServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AdminServlet</servlet-name>
    <url-pattern>/api/admin/me</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AdminAppealServlet</servlet-name>
    <servlet-class>com.campusquest.servlet.AdminAppealServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AdminAppealServlet</servlet-name>
    <url-pattern>/api/admin/appeals/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>AdminTaskServlet</servlet-name>
    <servlet-class>com.campusquest.servlet.AdminTaskServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>AdminTaskServlet</servlet-name>
    <url-pattern>/api/admin/tasks/*</url-pattern>
  </servlet-mapping>

  <servlet>
    <servlet-name>FileServlet</servlet-name>
    <servlet-class>com.campusquest.servlet.FileServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>FileServlet</servlet-name>
    <url-pattern>/uploads/*</url-pattern>
  </servlet-mapping>

  <welcome-file-list>
    <welcome-file>login.html</welcome-file>
  </welcome-file-list>
</web-app>
