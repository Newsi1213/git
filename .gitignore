# ============================================
# CampusQuest 版本控制忽略规则
# ============================================

# ---- Tomcat 运行时（第三方二进制，非源码）----
/tools/tomcat9/
# Tomcat 安装包原始压缩包（可重新下载的二进制）
/tools/*.zip

# ---- Tomcat 运行期目录（容器自动生成）----
**/work/
**/logs/
**/temp/

# ---- 用户上传文件（保留 uploads 目录本身）----
/uploads/*
!/uploads/.gitkeep

# ---- 数据库导出包与备份 ----
/backup/

# ---- 截图与临时产物 ----
/.screenshots/
# 工具生成的分享包产物（非源码）
/.trae-html-share-packages/

# ---- 编译产物 ----
*.class

# ---- 日志文件 ----
*.log

# ---- IDE 配置 ----
.idea/
.vscode/

# ---- 操作系统临时文件 ----
Thumbs.db
desktop.ini
